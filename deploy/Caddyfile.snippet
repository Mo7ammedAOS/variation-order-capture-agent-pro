# Append to the Caddyfile already fronting n8n on the VPS, then:
#   caddy validate --config /etc/caddy/Caddyfile
#   systemctl reload caddy
#
# TLS is automatic. Do not add a tls directive unless the certificate is
# supplied by hand.

vo.osmanflow.com {
    encode zstd gzip

    header {
        # Site engineers reach this from phones on mobile networks, so HSTS is
        # worth having. Only add preload once you are certain every subdomain
        # will stay on HTTPS permanently — it is very hard to undo.
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "DENY"
        Referrer-Policy           "strict-origin-when-cross-origin"
        Permissions-Policy        "geolocation=(), microphone=(), camera=(self)"
        -Server
    }

    # Evidence uploads are photographs taken on a phone. 25 MB matches the
    # limit enforced in document.service.ts; keep the two in step or the
    # proxy will reject a file the app would have accepted.
    request_body {
        max_size 25MB
    }

    reverse_proxy 127.0.0.1:3100 {
        header_up X-Real-IP {remote_host}
        # Uploads over a weak site connection are slow. The default 
        # timeouts will cut them off mid-transfer.
        transport http {
            read_timeout  300s
            write_timeout 300s
        }
    }
}

/**
 * The two points where the company commits to something outside itself.
 *
 * `notice_issue` is before the initial notice of variation reaches the client:
 * it starts a contractual clock and states a position, so it is not one
 * person's call. `final_variation` is after the price exists, and it commits
 * to a number.
 *
 * Nothing else in the flow is gated. An approval on every stage is how a
 * process becomes theatre and people start rubber-stamping.
 */
enum ApprovalGate {
  notice_issue
  final_variation
}

/**
 * A gate has two SEATS rather than a list of approvers.
 *
 * "The project manager and the managing director" is two decisions, one
 * operational and one commercial, and each seat is filled by whoever holds
 * that authority. Requiring every project manager to approve would stall a
 * project with two of them; requiring only one approval from a pool would let
 * the same person answer for both sides.
 */
enum ApprovalSeat {
  project_manager
  managing_director
}

enum ApprovalDecision {
  pending
  approved
  rejected
}

/**
 * Why a notification exists. Kept apart from the channel because the SAME
 * message goes out by three routes, and a person should not be chased three
 * times for three different reasons when it is one decision.
 */
/**
 * Where a rate came from. The single most argued line on any variation
 * account, so it is recorded per item rather than assumed.
 */
enum RateSource {
  /// A rate already in the priced BOQ. Hardest to dispute.
  contract_boq
  /// Derived from a BOQ rate for similar work.
  pro_rata
  /// New work with no comparable rate. Has to be agreed, and usually is not
  /// agreed quickly, which is why it is flagged rather than buried.
  star_rate
  /// A quotation from a subcontractor or supplier.
  quotation
  /// Time-related cost, e.g. prolongation.
  daywork
}

enum CostCategory {
  labour
  material
  plant
  subcontractor
  other
}

enum PricingStatus {
  not_started
  draft
  /// Frozen. The figure the approvers see is the figure that was submitted.
  submitted
  approved
}

/// Where a variation order has got to with the client.
enum VariationOrderStatus {
  draft
  submitted
  /// The client agreed the figure we put to them.
  approved
  /// The client agreed a LOWER figure. Not the same thing, and kept apart so
  /// the shortfall stays countable.
  part_approved
  rejected
  withdrawn
}

/// What the client actually said. Separate from the status because "no answer
/// for six weeks" is the most commercially important response there is, and
/// folding it into `submitted` would make it invisible.
enum ClientResponse {
  awaiting
  approved
  approved_with_adjustment
  rejected
  more_information_requested
}

/// A progress application, not a sales invoice. `part_paid` is a real resting
/// state in fit-out and is not an error.
///
/// `overdue` is deliberately ABSENT: it is `due_at < today AND status <> paid`,
/// and storing it would need a nightly job to keep true. A derived fact that
/// can go stale is worse than one computed on read.
enum InvoiceStatus {
  draft
  issued
  part_paid
  paid
  cancelled
}

/// What an invoice row IS. Both kinds ask the client for money and both are
/// paid the same way, which is why they share a table — but only an
/// application carries new work value, and conflating the two would double
/// count a job's turnover at the moment retention comes back.
enum InvoiceKind {
  /// A monthly progress application against an agreed variation.
  application
  /// Retention coming back at a contractual milestone. No new work value.
  retention_release
}

/// When retention falls due. UAE fit-out almost always releases in two
/// moieties, and the second one is a year after the first.
enum RetentionStage {
  practical_completion
  defects_liability_end
}

/// Why money is going back. Recorded as an enum and not as prose, because
/// "how much did we credit, and what for" is a question a director asks once a
/// quarter and prose cannot answer.
enum CreditNoteReason {
  /// We applied for more than was actually complete.
  over_certification
  /// It was billed against the wrong variation or the wrong period.
  wrong_invoice
  /// The client certified less and we have accepted it.
  client_deduction
  /// The same work was billed twice.
  duplicate
  other
}

enum CreditNoteStatus {
  draft
  issued
  cancelled
}

enum NotificationKind {
  task_assigned
  task_reminder
  task_escalation
  /// "Which project did you mean?" — answered by replying, not in the app.
  capture_question
  /// A notice of variation, addressed OUTSIDE the company. Its delivery result
  /// is evidence rather than convenience.
  notice_issued
  /// A weekly chase for an answer on a submitted variation, addressed OUTSIDE
  /// the company. Separate from `notice_issued` because it carries no
  /// contractual weight — nobody's entitlement turns on whether it arrived —
  /// and because "how often are we chasing this client" is a question worth
  /// being able to ask on its own.
  client_followup
}

enum NotificationChannel {
  email
  whatsapp
  in_app
}

/// A notification is only `sent` when the courier reports back. Never sooner.
enum DeliveryStatus {
  pending
  queued
  sent
  delivered
  failed
}


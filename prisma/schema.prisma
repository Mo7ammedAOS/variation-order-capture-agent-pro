// VO Capture & Control — database schema
//
// PostgreSQL is the system of record for all commercial truth. n8n never writes
// here; it calls authenticated app APIs which validate and write through services.
//
// One database per client deployment. Never shared, never multi-tenant.
//
// Three additions the product spec does not list, each load-bearing — see
// DATABASE_SCHEMA.md for the reasoning:
//   Project.pcSequence        race-safe PC numbering
//   IntegrationEvent          webhook idempotency (Rule 2)
//   *.driveFolderId / driveFileId   Google Drive is the store, this table is the index

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")

  // `vector` is ours. The rest ship with every Supabase project and live in the
  // `extensions` schema. They are declared here so `migrate dev` does not report
  // them as drift and offer to reset the database on every run — which is how
  // someone eventually says yes to that prompt on a database that has data in it.
  extensions = [vector, pgcrypto(schema: "extensions"), uuid_ossp(map: "uuid-ossp", schema: "extensions"), pg_stat_statements(schema: "extensions")]
}


}

/**
 * The two points where the company commits to something outside itself.
 *
 * `notice_issue` is before the initial notice of variation reaches the client:
 * it starts a contractual clock and states a position, so it is not one
 * person's call. `final_variation` is after the price exists, and it commits
 * to a number.
 *
 * Nothing else in the flow is gated. An approval on every stage is how a
 * process becomes theatre and people start rubber-stamping.
 */
enum ApprovalGate {
  notice_issue
  final_variation
}

/**
 * A gate has two SEATS rather than a list of approvers.
 *
 * "The project manager and the managing director" is two decisions, one
 * operational and one commercial, and each seat is filled by whoever holds
 * that authority. Requiring every project manager to approve would stall a
 * project with two of them; requiring only one approval from a pool would let
 * the same person answer for both sides.
 */
enum ApprovalSeat {
  project_manager
  managing_director
}

enum ApprovalDecision {
  pending
  approved
  rejected
}

/**
 * Why a notification exists. Kept apart from the channel because the SAME
 * message goes out by three routes, and a person should not be chased three
 * times for three different reasons when it is one decision.
 */
/**
 * Where a rate came from. The single most argued line on any variation
 * account, so it is recorded per item rather than assumed.
 */
enum RateSource {
  /// A rate already in the priced BOQ. Hardest to dispute.
  contract_boq
  /// Derived from a BOQ rate for similar work.
  pro_rata
  /// New work with no comparable rate. Has to be agreed, and usually is not
  /// agreed quickly, which is why it is flagged rather than buried.
  star_rate
  /// A quotation from a subcontractor or supplier.
  quotation
  /// Time-related cost, e.g. prolongation.
  daywork
}

enum CostCategory {
  labour
  material
  plant
  subcontractor
  other
}

enum PricingStatus {
  not_started
  draft
  /// Frozen. The figure the approvers see is the figure that was submitted.
  submitted
  approved
}

enum NotificationKind {
  task_assigned
  task_reminder
  task_escalation
}

enum NotificationChannel {
  email
  whatsapp
  in_app
}

/// A notification is only `sent` when the courier reports back. Never sooner.
enum DeliveryStatus {
  pending
  queued
  sent
  delivered
  failed
}


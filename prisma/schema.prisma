//  Company
// ─────────────────────────────────────────────────────────────────────────────

/// Exactly one row per deployment. Enforced by the `singleton` unique column.
model CompanySettings {
  id                        String   @id @default(uuid()) @db.Uuid
  singleton                 Boolean  @unique @default(true)
  legalCompanyName          String   @map("legal_company_name")
  displayCompanyName        String   @map("display_company_name")
  companyLogoUrl            String?  @map("company_logo_url")
  primaryColour             String   @default("#1e40af") @map("primary_colour")
  secondaryColour           String   @default("#0f172a") @map("secondary_colour")
  defaultCurrency           String   @default("AED") @map("default_currency")
  defaultLanguage           String   @default("en") @map("default_language")
  timezone                  String   @default("Asia/Dubai")
  workweekStartDay          Int      @default(1) @map("workweek_start_day")
  workweekEndDay            Int      @default(5) @map("workweek_end_day")
  defaultNoticeTemplate     String?  @map("default_notice_template")
  defaultVoTemplate         String?  @map("default_vo_template")
  defaultEmailSenderName    String?  @map("default_email_sender_name")
  defaultEmailSenderAddress String?  @map("default_email_sender_address")
  whatsappBusinessNumber    String?  @map("whatsapp_business_number")
  defaultApprovalMatrixJson Json?    @map("default_approval_matrix_json")
  defaultReminderRulesJson  Json?    @map("default_reminder_rules_json")
  defaultEscalationRulesJson Json?   @map("default_escalation_rules_json")
  /// RAG thresholds in days remaining. Defaults documented in ARCHITECTURE.md.
  riskAmberThresholdDays    Int      @default(7) @map("risk_amber_threshold_days")
  /// UAE VAT, 5% since 2018. Held as a setting rather than a constant because
  /// a rate change must not require a deploy, and because a zero-rated or
  /// exempt deployment is a real case.
  vatPercent                Decimal  @default(5) @map("vat_percent") @db.Decimal(6, 3)
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@map("company_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
//  People
// ─────────────────────────────────────────────────────────────────────────────

/// `id` is the Supabase `auth.users` UUID. Accounts are admin-created; there is
/// no public signup. Leavers are deactivated, never deleted, so the audit trail
/// keeps pointing at a real person.
model User {
  id                String     @id @db.Uuid
  fullName          String     @map("full_name")
  email             String     @unique
  phone             String?
  avatarUrl         String?    @map("avatar_url")
  systemRole        SystemRole @default(standard_user) @map("system_role")

  /// Company administration, deliberately SEPARATE from systemRole.
  ///
  /// Whoever administers the app is chosen by the company, and their job is
  /// usually something else — a Finance Manager, an office manager. Folding
  /// administration into systemRole forced a false choice between "what this
  /// person does" and "this person holds the keys", so it is its own flag.
  ///
  /// The company can never reach zero holders; user.service enforces that.
  canAdministerCompany Boolean @default(false) @map("can_administer_company")
  preferredLanguage String     @default("en") @map("preferred_language")
  active            Boolean    @default(true)
  lastLoginAt       DateTime?  @map("last_login_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  memberships          ProjectMember[]  @relation("MemberUser")
  assignedMemberships  ProjectMember[]  @relation("AssignedByUser")
  createdProjects      Project[]        @relation("ProjectCreatedBy")
  reportedChanges      PotentialChange[] @relation("PCReportedBy")
  ownedChanges         PotentialChange[] @relation("PCCurrentOwner")
  assignedTasks        Task[]           @relation("TaskAssignedTo")
  delegatedTasks       Task[]           @relation("TaskAssignedBy")
  blockingBottlenecks  Bottleneck[]     @relation("BottleneckBlockedByUser")
  uploadedDocuments    ProjectDocument[]
  activityLogs         ActivityLog[]
  notifications        NotificationLog[]
  captureQuestions     CaptureQuestion[]
  approvalsAssigned    Approval[]       @relation("ApprovalAssignedTo")
  approvalsDecided     Approval[]       @relation("ApprovalDecidedBy")
  pricingSubmitted     PotentialChange[] @relation("PricingSubmittedBy")
  noticesDrafted       Notice[]         @relation("NoticeDraftedBy")
  noticesIssued        Notice[]         @relation("NoticeIssuedBy")
  noticesAcknowledged  Notice[]         @relation("NoticeAcknowledgedBy")
  vosSubmitted         VariationOrder[] @relation("VoSubmittedBy")
  vosResponseRecorded  VariationOrder[] @relation("VoResponseRecordedBy")
  invoicesIssued       Invoice[]        @relation("InvoiceIssuedBy")
  creditNotesIssued     CreditNote[]      @relation("CreditNoteIssuedBy")
  paymentsRecorded     Payment[]        @relation("PaymentRecordedBy")

  @@index([systemRole])
  @@index([active])
  @@index([canAdministerCompany])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
//  Projects
// ─────────────────────────────────────────────────────────────────────────────

model Project {
  id                     String        @id @default(uuid()) @db.Uuid
  projectCode            String        @unique @map("project_code")
  projectName            String        @map("project_name")
  clientName             String        @map("client_name")
  consultantName         String?       @map("consultant_name")
  projectLocation        String?       @map("project_location")
  contractNumber         String?       @map("contract_number")
  contractStartDate      DateTime?     @map("contract_start_date") @db.Date
  contractCompletionDate DateTime?     @map("contract_completion_date") @db.Date
  originalContractValue  Decimal?      @map("original_contract_value") @db.Decimal(18, 2)
  currency               String        @default("AED")
  projectStatus          ProjectStatus @default(active) @map("project_status")

  /// Monotonic counter behind the PC number. Incremented atomically inside the
  /// create transaction — MAX(seq)+1 races under concurrent capture.
  pcSequence    Int     @default(0) @map("pc_sequence")
  /// The same idea for notices, and a SEPARATE series on purpose. A notice
  /// reference gets quoted in correspondence and read back months later, so it
  /// must not move because a change was renumbered, and it must not imply that
  /// PC-0042 produced notice 0042 when most changes never produce one at all.
  noticeSequence Int    @default(0) @map("notice_sequence")
  /// And again for variation orders. Three series, because a VO number is the
  /// one the client quotes on a payment certificate and it must never move.
  voSequence     Int    @default(0) @map("vo_sequence")
  /// Invoice numbers are a per-project series too. A company-wide series would
  /// leak how much work the contractor has on, to every client who sees a gap.
  invoiceSequence Int   @default(0) @map("invoice_sequence")
  /// Credit notes carry their own series. A credit quoted in correspondence
  /// must not share a number with an invoice.
  creditNoteSequence Int @default(0) @map("credit_note_sequence")
  /// Google Drive folder for this project. Ids are authoritative; folder names
  /// are cosmetic, so renaming in Drive never breaks the app.
  driveFolderId String? @map("drive_folder_id")

  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  createdBy        User?               @relation("ProjectCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  members          ProjectMember[]
  contractRules    ProjectContractRule?
  contacts         Contact[]
  documents        ProjectDocument[]
  potentialChanges PotentialChange[]
  approvals        Approval[]
  pricingLineItems PricingLineItem[]
  tasks            Task[]
  bottlenecks      Bottleneck[]
  activityLogs     ActivityLog[]
  documentChunks   DocumentChunk[]
  notices          Notice[]
  variationOrders  VariationOrder[]
  invoices         Invoice[]
  creditNotes      CreditNote[]
  payments         Payment[]

  @@index([projectStatus])
  @@index([clientName])
  @@map("projects")
}

/// Grants one person authority on one project. Absence of a row is the denial —
/// there is no "deny" record to forget to write.
model ProjectMember {
  id                     String      @id @default(uuid()) @db.Uuid
  projectId              String      @map("project_id") @db.Uuid
  userId                 String      @map("user_id") @db.Uuid
  projectRole            ProjectRole @map("project_role")
  permissionOverrideJson Json?       @map("permission_override_json")

  /// "Who should be updated here" — Osman's phrase, and deliberately NOT the
  /// same thing as access.
  ///
  /// A commercial director may need telling when a change is raised on a
  /// project they never open. A site engineer needs full access and does not
  /// need a message every time a colleague files something. Conflating the two
  /// gives you either a silent system or one everybody mutes.
  notifyOnChange         Boolean     @default(false) @map("notify_on_change")

  active                 Boolean     @default(true)
  assignedAt             DateTime    @default(now()) @map("assigned_at")
  assignedByUserId       String?     @map("assigned_by_user_id") @db.Uuid
  createdAt              DateTime    @default(now()) @map("created_at")
  updatedAt              DateTime    @updatedAt @map("updated_at")

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User    @relation("MemberUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User?   @relation("AssignedByUser", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@unique([projectId, userId, projectRole])
  @@index([userId, active])
  @@index([projectId, active])
  @@map("project_members")
}

/// The contractual clock. Every notice deadline in the system is derived from
/// `noticePeriodDays` here, never from a global default.
model ProjectContractRule {
  id                      String  @id @default(uuid()) @db.Uuid
  projectId               String  @unique @map("project_id") @db.Uuid
  contractType            String? @map("contract_type")
  contractClauseReference String? @map("contract_clause_reference")

  noticePeriodDays        Int     @default(28) @map("notice_period_days")
  detailedClaimPeriodDays Int     @default(42) @map("detailed_claim_period_days")
  noticeDeliveryMethod    String? @map("notice_delivery_method")
  noticeRecipientName     String? @map("notice_recipient_name")
  noticeRecipientEmail    String? @map("notice_recipient_email")
  noticeRecipientCompany  String? @map("notice_recipient_company")

  noticeTemplateName             String? @map("notice_template_name")
  variationProposalTemplateName  String? @map("variation_proposal_template_name")
  eotAssessmentRequired          Boolean @default(true) @map("eot_assessment_required")

  approvalThresholdPm                Decimal? @map("approval_threshold_pm") @db.Decimal(18, 2)
  approvalThresholdCm                Decimal? @map("approval_threshold_cm") @db.Decimal(18, 2)
  approvalThresholdCommercialDirector Decimal? @map("approval_threshold_commercial_director") @db.Decimal(18, 2)
  approvalThresholdManagingDirector  Decimal? @map("approval_threshold_managing_director") @db.Decimal(18, 2)
  highRiskVoValue                    Decimal? @map("high_risk_vo_value") @db.Decimal(18, 2)

  /// Held back from every progress application until practical completion.
  /// 5% and 10% are both ordinary in UAE fit-out, so it is per project, never
  /// a global default.
  retentionPercent       Decimal @default(5) @map("retention_percent") @db.Decimal(6, 3)
  /// Days from the invoice date to the date it falls due.
  paymentTermsDays       Int     @default(30) @map("payment_terms_days")
  /// How much of the retention comes back at practical completion. The rest
  /// follows at the end of the defects liability period. Half and half is the
  /// UAE fit-out norm, and both moieties are contractual, not discretionary.
  retentionReleasePercentAtPc Decimal @default(50) @map("retention_release_percent_at_pc") @db.Decimal(6, 3)
  /// How long after practical completion the second moiety falls due.
  defectsLiabilityDays   Int     @default(365) @map("defects_liability_days")
  /// How long the client gets before an unanswered VO is a bottleneck.
  voResponseDays         Int     @default(14) @map("vo_response_days")

  /// Whether this project chases the client at all for an answer on a
  /// submitted variation. Some contracts are chased by the commercial manager
  /// in person, where an automated letter would cut across him, so it is the
  /// company's call, per project, and off is a legitimate answer.
  clientFollowUpEnabled  Boolean @default(true) @map("client_follow_up_enabled")
  /// Days between one chase and the next, once the client's own response
  /// period has run. 7 is weekly. It is an interval, not a delay before the
  /// first one — `voResponseDays` decides when chasing may start at all.
  clientFollowUpDays     Int @default(7) @map("client_follow_up_days")
  qsPricingDueDays       Int @default(7) @map("qs_pricing_due_days")
  pmScopeReviewDueDays   Int @default(3) @map("pm_scope_review_due_days")
  internalApprovalDueDays Int @default(5) @map("internal_approval_due_days")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_contract_rules")
}

/// The authority register. Answers "was this person allowed to ask for that?"
/// Capability flags are set by a human. AI never sets them.
model Contact {
  id          String      @id @default(uuid()) @db.Uuid
  projectId   String      @map("project_id") @db.Uuid
  fullName    String      @map("full_name")
  companyName String?     @map("company_name")
  jobTitle    String?     @map("job_title")
  email       String?
  phone       String?
  contactType ContactType @default(other) @map("contact_type")

  authorityVerified          Boolean @default(false) @map("authority_verified")
  canRequestChange           Boolean @default(false) @map("can_request_change")
  canIssueTechnicalInstruction Boolean @default(false) @map("can_issue_technical_instruction")
  canInstructWork            Boolean @default(false) @map("can_instruct_work")
  canApproveCost             Boolean @default(false) @map("can_approve_cost")
  canApproveTime             Boolean @default(false) @map("can_approve_time")
  canSignFinalVo             Boolean @default(false) @map("can_sign_final_vo")

  active    Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedChanges PotentialChange[] @relation("PCRequestedByContact")
  bottlenecks      Bottleneck[]      @relation("BottleneckBlockedByContact")

  @@index([projectId, active])
  @@index([email])
  @@map("contacts")
}

/// Metadata for a file. The bytes live in Drive; this row is the index and the
/// access-control boundary. Files are served through an authenticated proxy,
/// never a Drive link.
model ProjectDocument {
  id               String         @id @default(uuid()) @db.Uuid
  projectId        String         @map("project_id") @db.Uuid
  potentialChangeId String?       @map("potential_change_id") @db.Uuid
  documentType     DocumentType   @default(other) @map("document_type")
  documentName     String         @map("document_name")
  documentNumber   String?        @map("document_number")
  revisionNumber   String?        @map("revision_number")
  issueDate        DateTime?      @map("issue_date") @db.Date
  sourceUrl        String?        @map("source_url")
  storagePath      String?        @map("storage_path")
  driveFileId      String?        @map("drive_file_id")
  mimeType         String?        @map("mime_type")
  sizeBytes        Int?           @map("size_bytes")
  uploadedByUserId String?        @map("uploaded_by_user_id") @db.Uuid
  approvedStatus   ApprovedStatus @default(not_applicable) @map("approved_status")
  isCurrentRevision Boolean       @default(true) @map("is_current_revision")
  sourceChannel    SourceType     @default(mobile_form) @map("source_channel")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  potentialChange PotentialChange? @relation(fields: [potentialChangeId], references: [id], onDelete: SetNull)
  uploadedBy      User?            @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  chunks          DocumentChunk[]
  noticeRecord    Notice?
  variationOrder  VariationOrder?

  @@index([projectId, documentType])
  @@index([potentialChangeId])
  @@index([driveFileId])
  @@map("project_documents")
}

// ─────────────────────────────────────────────────────────────────────────────
//  The commercial record
// ─────────────────────────────────────────────────────────────────────────────

/// The heart of the system. Captured immediately, assessed for notice risk
/// immediately, priced and proved in parallel.
model PotentialChange {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  /// PC-{PROJECT_CODE}-{sequence:0000}
  pcNumber  String @map("pc_number")

  title       String
  /// WHAT THE REPORTER ACTUALLY WROTE, with the email furniture stripped off —
  /// signature, quoted history, disclaimer. Never rewritten, never paraphrased,
  /// because this exact text is printed under WHAT HAPPENED in a contractual
  /// notice, and a model's improvement on somebody's words is not evidence of
  /// what they said.
  description String
  /// The model's standardised restatement of the same thing: one or two plain
  /// sentences a commercial manager can scan.
  ///
  /// A SEPARATE field rather than a better `description`, and the distinction
  /// is the whole point. This is convenience and is allowed to be wrong; the
  /// description is evidence and is not. Nothing contractual reads this.
  /// Null when the model was off, declined, or added nothing.
  summary     String?

  sourceType                SourceType      @default(mobile_form) @map("source_type")
  /// WHERE the change was raised, which is not where the change is.
  /// `location` is the place on site the work is affected — "Reception, Level 2".
  /// This is the meeting room, the platform, or the WhatsApp group the
  /// instruction arrived through. Conflating the two loses the ability to
  /// answer "who told us, and where were we standing", which is the question a
  /// verbal instruction turns on.
  sourceLocation            String?         @map("source_location")
  /// WHEN it was raised, which is not when it happened. `eventDate` starts the
  /// contractual clock; this is when somebody first said so. They are usually
  /// the same day and occasionally weeks apart, and the gap is itself evidence.
  sourceOccurredAt          DateTime?       @map("source_occurred_at")
  sourceReference           String?         @map("source_reference")
  sourceMessageId           String?         @map("source_message_id")
  sourceSenderName          String?         @map("source_sender_name")
  sourceSenderPhoneOrEmail  String?         @map("source_sender_phone_or_email")
  sourceSenderAuthorityStatus AuthorityStatus @default(unknown) @map("source_sender_authority_status")

  reportedByUserId     String?  @map("reported_by_user_id") @db.Uuid
  requestedByContactId String?  @map("requested_by_contact_id") @db.Uuid

  eventDate   DateTime @map("event_date") @db.Date
  captureDate DateTime @default(now()) @map("capture_date")

  location String?
  trade    String?
  category String?

  workStatus          WorkStatus @default(not_started) @map("work_status")
  estimatedValue      Decimal?   @map("estimated_value") @db.Decimal(18, 2)
  potentialTimeImpact Boolean    @default(false) @map("potential_time_impact")
  timeImpactDays      Int?       @map("time_impact_days")

  currentStatus     PotentialChangeStatus @default(new_potential_change) @map("current_status")
  currentOwnerUserId String?              @map("current_owner_user_id") @db.Uuid
  waitingFor        String?               @map("waiting_for")
  nextAction        String?               @map("next_action")
  nextActionDueDate DateTime?             @map("next_action_due_date") @db.Date
  blockerReason     String?               @map("blocker_reason")
  riskLevel         RiskLevel             @default(green) @map("risk_level")

  noticeRequired       Boolean      @default(false) @map("notice_required")
  noticeDueDate        DateTime?    @map("notice_due_date") @db.Date
  noticeStatus         NoticeStatus @default(not_assessed) @map("notice_status")
  noticeAssessedAt     DateTime?    @map("notice_assessed_at")
  noticeAssessedByUserId String?    @map("notice_assessed_by_user_id") @db.Uuid
  noticeAssessmentNotes String?     @map("notice_assessment_notes")

  driveFolderId String? @map("drive_folder_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project           Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reportedBy        User?                    @relation("PCReportedBy", fields: [reportedByUserId], references: [id], onDelete: SetNull)
  currentOwner      User?                    @relation("PCCurrentOwner", fields: [currentOwnerUserId], references: [id], onDelete: SetNull)
  requestedByContact Contact?                @relation("PCRequestedByContact", fields: [requestedByContactId], references: [id], onDelete: SetNull)
  pricingStatus       PricingStatus @default(not_started) @map("pricing_status")
  /// Percentages, held apart from the line items because they apply to the
  /// whole build-up and are negotiated separately from any single rate.
  prelimsPercent      Decimal?      @map("prelims_percent") @db.Decimal(6, 3)
  overheadProfitPercent Decimal?    @map("overhead_profit_percent") @db.Decimal(6, 3)
  /// The frozen figure. Set once, at submission, and never recomputed — the
  /// number two directors approve must be the number that was put to them.
  submittedValue      Decimal?      @map("submitted_value") @db.Decimal(14, 2)
  submittedAt         DateTime?     @map("submitted_at")
  submittedByUserId   String?       @map("submitted_by_user_id") @db.Uuid
  pricingNotes        String?       @map("pricing_notes")

  submittedBy User? @relation("PricingSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: SetNull)

  approvals         Approval[]
  pricingLineItems  PricingLineItem[]
  tasks             Task[]
  bottlenecks       Bottleneck[]
  documents         ProjectDocument[]
  embedding         PotentialChangeEmbedding?
  notifications     NotificationLog[]
  notices           Notice[]
  variationOrder    VariationOrder?

  @@unique([projectId, pcNumber])
  @@index([projectId, currentStatus])
  @@index([projectId, riskLevel])
  @@index([currentOwnerUserId])
  @@index([noticeDueDate])
  @@index([nextActionDueDate])
  @@index([trade])
  @@map("potential_changes")
}

model Task {
  id                String  @id @default(uuid()) @db.Uuid
  projectId         String  @map("project_id") @db.Uuid
  potentialChangeId String? @map("potential_change_id") @db.Uuid

  taskType    TaskType @map("task_type")
  title       String
  description String?

  assignedToUserId String?   @map("assigned_to_user_id") @db.Uuid
  assignedByUserId String?   @map("assigned_by_user_id") @db.Uuid
  dueDate          DateTime? @map("due_date") @db.Date

  status          TaskStatus      @default(open)
  priority        Priority        @default(normal)
  escalationLevel EscalationLevel @default(none) @map("escalation_level")
  completedAt     DateTime?       @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  potentialChange PotentialChange? @relation(fields: [potentialChangeId], references: [id], onDelete: Cascade)
  assignedTo      User?            @relation("TaskAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  assignedBy      User?            @relation("TaskAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  notifications   NotificationLog[]

  @@index([assignedToUserId, status])
  @@index([projectId, status])
  @@index([dueDate, status])
  @@index([potentialChangeId])
  @@map("tasks")
}

/// "What is blocked, who owns it, how long has it waited, what is at risk."
/// Detected by the application. n8n only delivers the message about it.
model Bottleneck {
  id                String  @id @default(uuid()) @db.Uuid
  projectId         String  @map("project_id") @db.Uuid
  potentialChangeId String? @map("potential_change_id") @db.Uuid

  bottleneckType           BottleneckType @map("bottleneck_type")
  blockedByRole            String?        @map("blocked_by_role")
  blockedByUserId          String?        @map("blocked_by_user_id") @db.Uuid
  blockedByExternalContactId String?      @map("blocked_by_external_contact_id") @db.Uuid
  blockerReason            String?        @map("blocker_reason")

  riskLevel       RiskLevel       @default(amber) @map("risk_level")
  firstDetectedAt DateTime        @default(now()) @map("first_detected_at")
  lastReminderAt  DateTime?       @map("last_reminder_at")
  overdueDays     Int             @default(0) @map("overdue_days")
  escalationLevel EscalationLevel @default(none) @map("escalation_level")
  valueAtRisk     Decimal?        @map("value_at_risk") @db.Decimal(18, 2)
  resolvedAt      DateTime?       @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  potentialChange PotentialChange? @relation(fields: [potentialChangeId], references: [id], onDelete: Cascade)
  blockedByUser   User?            @relation("BottleneckBlockedByUser", fields: [blockedByUserId], references: [id], onDelete: SetNull)
  blockedByContact Contact?        @relation("BottleneckBlockedByContact", fields: [blockedByExternalContactId], references: [id], onDelete: SetNull)

  @@index([projectId, resolvedAt])
  @@index([potentialChangeId])
  @@index([riskLevel, resolvedAt])
  @@map("bottlenecks")
}

/// Append only. Never updated, never deleted. Written in the same transaction
/// as the change it describes, so an audit gap cannot happen.
model ActivityLog {
  id           String         @id @default(uuid()) @db.Uuid
  projectId    String?        @map("project_id") @db.Uuid
  userId       String?        @map("user_id") @db.Uuid
  recordType   String         @map("record_type")
  recordId     String         @map("record_id")
  actionType   String         @map("action_type")
  oldValueJson Json?          @map("old_value_json")
  newValueJson Json?          @map("new_value_json")
  source       ActivitySource @default(web_app)
  metadataJson Json?          @map("metadata_json")
  createdAt    DateTime       @default(now()) @map("created_at")

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([recordType, recordId])
  @@index([userId, createdAt])
  @@map("activity_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
//  Integration boundary
// ─────────────────────────────────────────────────────────────────────────────

/// Every inbound event from n8n lands here first. The unique (source, externalId)
/// is what makes a retried webhook safe: the second delivery finds this row and
/// returns the original result instead of creating a second Potential Change.
enum CaptureQuestionKind {
  /// "Which of these four?" — the reporter picks.
  choose
  /// "This is DXB-001, correct?" — we read it out of their message and they
  /// only have to agree.
  confirm
  /// "These photos: a new change, or one of these?" — asked when files arrive
  /// with no words, once the project is settled.
  attach
  /// "Tell me in one line what changed." — asked when files arrive with no
  /// words and the reporter says they belong to nothing yet.
  describe
  /// "When did it happen, and which drawing?" — asked AFTER a change is filed,
  /// so the follow-up never delays the notice clock it exists to correct.
  detail
  /// The read-back: everything understood so far, awaiting a yes.
  summary
}

enum CaptureQuestionStatus {
  open
  answered
  expired
  cancelled
}

/// A question put to the person who reported a change, still outstanding.
///
/// Raised when the reporter is on several active projects and named none. The
/// alternative to asking is guessing, and a change filed against the wrong job
/// looks handled — so nobody ever looks at it again.
model CaptureQuestion {
  id                  String                @id @default(uuid()) @db.Uuid
  integrationEventId  String                @unique @map("integration_event_id") @db.Uuid
  userId              String                @map("user_id") @db.Uuid
  /// Whether we are asking them to CHOOSE from a list or to CONFIRM one we
  /// read out of their own words. The difference is not cosmetic: a confirm
  /// accepts "yes", and a "no" to a confirm re-opens the full list rather than
  /// leaving the reporter with nothing to say.
  kind                CaptureQuestionKind   @default(choose)
  /// Short and typable, so a reply is unambiguous when two are outstanding.
  token               String                @unique
  /// Frozen when asked. Re-reading memberships later would make "2" drift.
  candidateProjectIds String[]              @map("candidate_project_ids") @db.Uuid
  askedText           String?               @map("asked_text")
  /// The message we are answering, so the question goes back as a REPLY on the
  /// same thread instead of arriving as a fresh email nobody connects to it.
  sourceMessageId     String?               @map("source_message_id")
  sourceSubject       String?               @map("source_subject")
  /// The Potential Changes offered by an `attach` question, frozen at ask time
  /// for the same reason the project list is: a number in the reply and a
  /// number in the message have to mean the same thing an hour later.
  candidateChangeIds  String[]              @default([]) @map("candidate_change_ids") @db.Uuid
  /// The project once it is settled. An `attach` or `describe` question has
  /// already had its project answered, and re-deriving it would let a later
  /// membership change move where the files land.
  projectId           String?               @map("project_id") @db.Uuid
  /// The change a `detail` question is about.
  potentialChangeId   String?               @map("potential_change_id") @db.Uuid
  /// Which facts were asked for, so the reply is read for those and only those.
  detailFields        String[]              @default([]) @map("detail_fields")
  /// How many times this has been put to the reporter. Re-asking is capped:
  /// a question nobody answers twice is not going to be answered a third time,
  /// and asking again is how a system teaches people to ignore it.
  askCount            Int                   @default(1) @map("ask_count")
  status              CaptureQuestionStatus @default(open)
  chosenProjectId     String?               @map("chosen_project_id") @db.Uuid
  askedAt             DateTime              @default(now()) @map("asked_at")
  answeredAt          DateTime?             @map("answered_at")
  expiresAt           DateTime              @map("expires_at")

  integrationEvent IntegrationEvent @relation(fields: [integrationEventId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("capture_questions")
}

model IntegrationEvent {
  id         String                 @id @default(uuid()) @db.Uuid
  source     IntegrationSource
  externalId String                 @map("external_id")
  status     IntegrationEventStatus @default(received)
  payloadJson Json                  @map("payload_json")
  resultJson Json?                  @map("result_json")
  errorMessage String?              @map("error_message")
  receivedAt DateTime               @default(now()) @map("received_at")
  processedAt DateTime?             @map("processed_at")

  captureQuestion CaptureQuestion?

  @@unique([source, externalId])
  @@index([status, receivedAt])
  @@map("integration_events")
}

/// A notification becomes `sent` only when the courier reports back through
/// /api/integrations/notifications/delivery-status. Until then it is pending,
/// and on failure it is failed — never "notice sent".
model NotificationLog {
  id                String              @id @default(uuid()) @db.Uuid
  potentialChangeId String?             @map("potential_change_id") @db.Uuid
  taskId            String?             @map("task_id") @db.Uuid
  /// Who this is for. Null on messages addressed outside the company.
  userId            String?             @map("user_id") @db.Uuid
  kind              NotificationKind    @default(task_assigned)
  channel           NotificationChannel
  recipient         String
  subject           String?
  body              String?
  payloadSummary    String?             @map("payload_summary")
  escalationLevel   EscalationLevel     @default(none) @map("escalation_level")
  status            DeliveryStatus      @default(pending)
  externalMessageId String?             @map("external_message_id")
  /// The inbound message this one answers. Passed to n8n so lane D can set
  /// In-Reply-To and the reply lands in the thread the person already has open,
  /// rather than as a new email they read as spam from their own system.
  replyToMessageId  String?             @map("reply_to_message_id")
  failureReason     String?             @map("failure_reason")

  /// What makes the daily sweep safe to run twice.
  ///
  /// Shaped `task:<id>:<kind>:<yyyy-mm-dd>:<channel>:<recipient>`, so a second
  /// run on the same day collides on the unique index and inserts nothing. The
  /// alternative — remembering in the application when it last ran — loses that
  /// memory on every container restart, and the failure mode is chasing a
  /// director six times before lunch.
  dedupeKey         String              @unique @map("dedupe_key")

  readAt        DateTime? @map("read_at")
  requestedAt   DateTime  @default(now()) @map("requested_at")
  lastAttemptAt DateTime? @map("last_attempt_at")
  sentAt        DateTime? @map("sent_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  potentialChange PotentialChange? @relation(fields: [potentialChangeId], references: [id], onDelete: SetNull)
  task            Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  notice          Notice?

  @@index([status, requestedAt])
  @@index([potentialChangeId])
  @@index([userId, readAt])
  @@index([taskId])
  @@map("notification_logs")
}

/// The notice itself.
///
/// ── Why this is a table and not four columns on the change ────────────────
/// A rejected notice is redrafted, and the round that was rejected has to
/// survive intact — it is what explains, later, why the notice that went out
/// says what it says. Columns on the change would be overwritten by the
/// redraft, and the file would lose its own history at the exact point
/// somebody is arguing about it.
///
/// ── The text is frozen at issue, not rendered at read ─────────────────────
/// `subject` and `body` hold the words that were approved. Regenerating them
/// from the template on each read would silently rewrite a served notice every
/// time the template, the rates or the change description moved. What was sent
/// is what was sent.
model Notice {
  id                String @id @default(uuid()) @db.Uuid
  projectId         String @map("project_id") @db.Uuid
  potentialChangeId String @map("potential_change_id") @db.Uuid

  /// NOT-{PROJECT_CODE}-{sequence:0000}. Its own series, because a notice
  /// reference is quoted in correspondence and must not move when a change is
  /// renumbered.
  reference String
  /// 1, then 2 after a rejection. Together with the change, unique.
  version   Int               @default(1)
  status    NoticeIssueStatus @default(draft)

  subject String
  body    String

  recipientName    String? @map("recipient_name")
  recipientCompany String? @map("recipient_company")
  recipientEmail   String? @map("recipient_email")
  clauseReference  String? @map("clause_reference")

  draftedByUserId String?   @map("drafted_by_user_id") @db.Uuid
  draftedAt       DateTime  @default(now()) @map("drafted_at")
  issuedByUserId  String?   @map("issued_by_user_id") @db.Uuid
  issuedAt        DateTime? @map("issued_at")
  sentAt          DateTime? @map("sent_at")
  /// The courier's own id for the message. Without one there is no proof of
  /// service, which is why `notice_sent_no_proof` is a bottleneck type.
  externalMessageId String? @map("external_message_id")

  acknowledgedAt           DateTime? @map("acknowledged_at")
  acknowledgedByUserId     String?   @map("acknowledged_by_user_id") @db.Uuid
  acknowledgementReference String?   @map("acknowledgement_reference")

  /// The PDF filed in `08 Notices`. Null until issue: a draft is not a record.
  documentId     String? @unique @map("document_id") @db.Uuid
  /// The outbound message carrying it. The delivery callback finds the notice
  /// through this.
  notificationId String? @unique @map("notification_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  potentialChange PotentialChange  @relation(fields: [potentialChangeId], references: [id], onDelete: Cascade)
  document        ProjectDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  notification    NotificationLog? @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  draftedBy       User?            @relation("NoticeDraftedBy", fields: [draftedByUserId], references: [id], onDelete: SetNull)
  issuedBy        User?            @relation("NoticeIssuedBy", fields: [issuedByUserId], references: [id], onDelete: SetNull)
  acknowledgedBy  User?            @relation("NoticeAcknowledgedBy", fields: [acknowledgedByUserId], references: [id], onDelete: SetNull)

  @@unique([potentialChangeId, version])
  @@unique([projectId, reference])
  @@index([projectId, status])
  @@map("notices")
}

// ─────────────────────────────────────────────────────────────────────────────
//  The money end
//
//  Everything below answers one question a director asks and nothing else can:
//  how much work have we agreed, and how much of it have we actually been paid
//  for. The gap between those two numbers is what this product is for.
//
//  Three rules hold throughout, and each of them was a decision:
//
//  1. VALUES ARE FROZEN WHEN THEY ARE PUT TO SOMEBODY. A submitted VO carries
//     the figure that was submitted, not a figure recomputed from today's line
//     items. An invoice carries the arithmetic as it stood the day it was
//     issued. Recomputing on read means a document quietly disagreeing with the
//     paper copy the client is holding.
//
//  2. NOTHING DERIVED IS STORED. "Overdue", "approved but unbilled", "retention
//     held" are computed on read from rows that cannot go stale. A stored total
//     needs a job to maintain it, and the day that job fails is the day the
//     number is wrong AND confident.
//
//  3. ONE VO PER CHANGE. Osman's decision, 2026-09-01. A rejected VO drags
//     nothing else down with it, and a partial approval never has to be
//     apportioned back across changes by somebody guessing.
// ─────────────────────────────────────────────────────────────────────────────

/// What we put to the client, and what they said back.
model VariationOrder {
  id                String @id @default(uuid()) @db.Uuid
  projectId         String @map("project_id") @db.Uuid
  /// One per change. The unique index is the rule, not a convention.
  potentialChangeId String @unique @map("potential_change_id") @db.Uuid

  /// VO-{PROJECT_CODE}-{sequence:0000}
  voNumber String               @map("vo_number")
  status   VariationOrderStatus @default(draft)

  title       String
  description String

  /// The figure we asked for, frozen at submission. Copied from the pricing
  /// build-up ONCE; later edits to the build-up never move it.
  submittedValue   Decimal?  @map("submitted_value") @db.Decimal(18, 2)
  submittedAt      DateTime? @map("submitted_at")
  submittedByUserId String?  @map("submitted_by_user_id") @db.Uuid
  timeImpactDaysClaimed Int? @map("time_impact_days_claimed")
  /// WHY those days are owed: which activity was delayed and why it is on the
  /// critical path. A number of days with no basis is refused by every
  /// engineer who has ever assessed one, so the field is the claim, not
  /// decoration.
  timeImpactBasis       String? @map("time_impact_basis")

  clientResponse       ClientResponse @default(awaiting) @map("client_response")
  clientResponseAt     DateTime?      @map("client_response_at")
  /// What they agreed to pay. Null until they answer. When it is lower than
  /// `submittedValue` the difference is a real, unagreed shortfall and stays
  /// visible — it is never written off by overwriting the submitted figure.
  approvedValue        Decimal?  @map("approved_value") @db.Decimal(18, 2)
  approvedTimeImpactDays Int?    @map("approved_time_impact_days")
  /// Their letter or certificate reference. The proof.
  clientReference      String?   @map("client_reference")
  clientResponseNotes  String?   @map("client_response_notes")
  recordedByUserId     String?   @map("recorded_by_user_id") @db.Uuid

  /// The submitted document, filed in `09 Variation Orders`.
  documentId String? @unique @map("document_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  potentialChange PotentialChange  @relation(fields: [potentialChangeId], references: [id], onDelete: Cascade)
  document        ProjectDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  submittedBy     User?            @relation("VoSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  recordedBy      User?            @relation("VoResponseRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  invoices        Invoice[]

  @@unique([projectId, voNumber])
  @@index([projectId, status])
  @@index([clientResponse, submittedAt])
  @@map("variation_orders")
}

/// A progress application against one variation order.
///
/// Osman's decision, 2026-09-01: fit-out is billed monthly against a
/// percentage of the agreed value, with retention held back, not as one
/// invoice per VO. So this is an APPLICATION, and several of them add up to
/// the VO.
///
/// `cumulativePercent` is what a person enters, because that is what a
/// valuation states: "we are 75% complete". Everything else on the row is
/// derived from it ONCE, at issue, and then frozen — including
/// `previouslyApplied`, so the arithmetic on the paper can always be
/// reproduced even if an earlier application is later cancelled.
model Invoice {
  id               String @id @default(uuid()) @db.Uuid
  projectId        String @map("project_id") @db.Uuid
  variationOrderId String @map("variation_order_id") @db.Uuid

  /// INV-{PROJECT_CODE}-{sequence:0000}
  invoiceNumber String        @map("invoice_number")
  status        InvoiceStatus @default(draft)
  /// An application, or retention coming back. Defaulted so every row written
  /// before retention release existed is still an application, which is what
  /// they all were.
  kind          InvoiceKind   @default(application)

  /// The valuation date. What period this application covers up to.
  periodEnd DateTime @map("period_end") @db.Date

  /// Cumulative completion of the VO at `periodEnd`, 0 to 100.
  cumulativePercent Decimal @map("cumulative_percent") @db.Decimal(6, 3)
  /// The agreed VO value this application was calculated against, frozen.
  /// If the client later revises the VO, old applications keep their basis.
  basisValue        Decimal @map("basis_value") @db.Decimal(18, 2)
  /// Gross certified by every earlier application, frozen at issue.
  previouslyApplied Decimal @map("previously_applied") @db.Decimal(18, 2)
  /// basisValue * cumulativePercent - previouslyApplied. This period only.
  grossThisPeriod   Decimal @map("gross_this_period") @db.Decimal(18, 2)

  retentionPercent Decimal @map("retention_percent") @db.Decimal(6, 3)
  retentionAmount  Decimal @map("retention_amount") @db.Decimal(18, 2)
  /// Retention coming BACK on this row. Always zero on an application, and the
  /// whole of a release. Held as its own column rather than as a negative
  /// `retentionAmount`, because "retention held" is a sum a commercial manager
  /// reads and a sign flip hidden inside it is a number nobody can check.
  retentionReleased Decimal @default(0) @map("retention_released") @db.Decimal(18, 2)
  /// Which moiety this release is. Null on an application.
  retentionStage    RetentionStage? @map("retention_stage")
  /// grossThisPeriod - retentionAmount, or the retention released
  netValue         Decimal @map("net_value") @db.Decimal(18, 2)
  vatPercent       Decimal @map("vat_percent") @db.Decimal(6, 3)
  vatAmount        Decimal @map("vat_amount") @db.Decimal(18, 2)
  /// netValue + vatAmount. What the client owes on this application.
  totalDue         Decimal @map("total_due") @db.Decimal(18, 2)

  issuedAt        DateTime? @map("issued_at")
  issuedByUserId  String?   @map("issued_by_user_id") @db.Uuid
  /// issuedAt + paymentTermsDays, frozen, because the terms may change later
  /// and this invoice fell due when it fell due.
  dueAt           DateTime? @map("due_at") @db.Date
  clientReference String?   @map("client_reference")
  notes           String?

  cancelledAt     DateTime? @map("cancelled_at")
  cancelledReason String?   @map("cancelled_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  variationOrder VariationOrder @relation(fields: [variationOrderId], references: [id], onDelete: Cascade)
  issuedBy       User?          @relation("InvoiceIssuedBy", fields: [issuedByUserId], references: [id], onDelete: SetNull)
  payments       Payment[]
  creditNotes    CreditNote[]

  @@unique([projectId, invoiceNumber])
  @@index([projectId, status])
  @@index([variationOrderId, periodEnd])
  @@index([status, dueAt])
  @@map("invoices")
}

/// Money actually received. Many per invoice, because part payment is normal
/// and pretending otherwise would force somebody to round.
/// Money going back to the client against an invoice already issued.
///
/// A separate document rather than a negative invoice, and separate rows
/// rather than an edit to the invoice. Two reasons, both of them about the
/// paper: the client is holding an invoice that says a number, and that number
/// must still be reproducible line for line a year later; and a credit is
/// approved by a person, on a date, for a stated reason, which an edit records
/// nowhere.
///
/// It mirrors the application arithmetic exactly — gross, retention, net, VAT —
/// because crediting an over-certification has to give back the retention that
/// was withheld on it too. A credit that returns the net but keeps the
/// retention quietly overstates what the company is still holding.
model CreditNote {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  /// The invoice being credited. A credit always points at a document the
  /// client can find in their own files.
  invoiceId String @map("invoice_id") @db.Uuid

  /// CN-{PROJECT_CODE}-{sequence:0000}
  creditNoteNumber String           @map("credit_note_number")
  status           CreditNoteStatus @default(draft)
  reason           CreditNoteReason
  /// Why, in words, for the person reading it in two years. Required — a
  /// credit with no explanation is indistinguishable from a mistake.
  narrative        String

  /// The gross being taken back off the application.
  grossAmount     Decimal @map("gross_amount") @db.Decimal(18, 2)
  /// Retention that was withheld on that gross and is no longer held.
  retentionAmount Decimal @map("retention_amount") @db.Decimal(18, 2)
  netValue        Decimal @map("net_value") @db.Decimal(18, 2)
  vatPercent      Decimal @map("vat_percent") @db.Decimal(6, 3)
  vatAmount       Decimal @map("vat_amount") @db.Decimal(18, 2)
  /// netValue + vatAmount. What comes off what the client owes.
  totalCredited   Decimal @map("total_credited") @db.Decimal(18, 2)

  issuedAt       DateTime? @map("issued_at")
  issuedByUserId String?   @map("issued_by_user_id") @db.Uuid

  cancelledAt     DateTime? @map("cancelled_at")
  cancelledReason String?   @map("cancelled_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoice  Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  issuedBy User?   @relation("CreditNoteIssuedBy", fields: [issuedByUserId], references: [id], onDelete: SetNull)

  @@unique([projectId, creditNoteNumber])
  @@index([projectId, status])
  @@index([invoiceId])
  @@map("credit_notes")
}

model Payment {
  id        String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  invoiceId String @map("invoice_id") @db.Uuid

  amount     Decimal  @db.Decimal(18, 2)
  receivedAt DateTime @map("received_at") @db.Date
  /// Cheque number, transfer reference, certificate number. The proof.
  reference  String?
  method     String?
  notes      String?

  recordedByUserId String?  @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy User?   @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([projectId, receivedAt])
  @@index([invoiceId])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────────────────────
//  Vectors
//
//  Prisma has no native vector type, so the columns are added by SQL migration
//  and declared Unsupported here. Every similarity query filters by project_id
//  BEFORE the ANN search — an unscoped search would surface one project's
//  correspondence inside another. See search.service.ts.
// ─────────────────────────────────────────────────────────────────────────────

model DocumentChunk {
  id         String @id @default(uuid()) @db.Uuid
  projectId  String @map("project_id") @db.Uuid
  documentId String @map("document_id") @db.Uuid
  chunkIndex Int    @map("chunk_index")
  content    String

  embedding      Unsupported("vector(384)")?
  embeddingModel String                      @map("embedding_model")
  embeddingDims  Int                         @map("embedding_dims")

  createdAt DateTime @default(now()) @map("created_at")

  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([projectId])
  @@map("document_chunks")
}

model PotentialChangeEmbedding {
  id                String @id @default(uuid()) @db.Uuid
  potentialChangeId String @unique @map("potential_change_id") @db.Uuid
  projectId         String @map("project_id") @db.Uuid
  content           String

  embedding      Unsupported("vector(384)")?
  embeddingModel String                      @map("embedding_model")
  embeddingDims  Int                         @map("embedding_dims")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  potentialChange PotentialChange @relation(fields: [potentialChangeId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("potential_change_embeddings")
}

/// Who may do what, as DATA rather than as code.
///
/// The capability matrix used to be a hardcoded table in src/lib/rbac.ts, which
/// meant that changing who may approve a variation was a code edit and a
/// redeploy. Every contractor runs differently — in one firm the QS prices and
/// the CM approves, in another the Contract Administrator does both — so the
/// matrix has to be the admin's to set, on the authority of their director.
///
/// Rows are the complete truth. A missing row is a denial, not a fallback to
/// some default in code, because a silent fallback is how a permission someone
/// believed they had revoked comes back on the next deploy. The defaults are
/// seeded into this table by a migration instead.
model RolePermission {
  id         String    @id @default(uuid()) @db.Uuid
  scope      RoleScope
  /// SystemRole or ProjectRole depending on scope. Held as text so adding a
  /// role to either enum cannot orphan rows in a mismatched column type.
  role       String
  capability String
  granted    Boolean   @default(true)

  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([scope, role, capability])
  @@index([scope, role])
  @@map("role_permissions")
}

enum RoleScope {
  system
  project
}

/**
 * One seat, at one gate, in one round.
 *
 * `round` is what makes a rejection recoverable. A rejected gate is not
 * deleted and re-created — that would erase the fact that someone said no, and
 * why. Resubmitting opens round 2 with fresh seats, and round 1 stays on the
 * record permanently.
 */
model Approval {
  id                String   @id @default(uuid()) @db.Uuid
  projectId         String   @map("project_id") @db.Uuid
  potentialChangeId String   @map("potential_change_id") @db.Uuid

  gate     ApprovalGate
  seat     ApprovalSeat
  round    Int              @default(1)
  decision ApprovalDecision @default(pending)

  /// Who it was put to. Null when nobody holds that authority yet — visible,
  /// rather than a gate that silently cannot be passed.
  assignedToUserId String?   @map("assigned_to_user_id") @db.Uuid
  decidedByUserId  String?   @map("decided_by_user_id") @db.Uuid
  decidedAt        DateTime? @map("decided_at")
  /// Required on a rejection. "No" without a reason cannot be acted on.
  comment          String?

  taskId String? @map("task_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  potentialChange PotentialChange @relation(fields: [potentialChangeId], references: [id], onDelete: Cascade)
  assignedTo      User?           @relation("ApprovalAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  decidedBy       User?           @relation("ApprovalDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@unique([potentialChangeId, gate, seat, round])
  @@index([potentialChangeId, gate])
  @@index([assignedToUserId, decision])
  @@map("approvals")
}

/**
 * One line of a variation build-up.
 *
 * `amount` is stored, and computed on the SERVER from quantity and rate. It is
 * never taken from the browser and never worked out in a template: a total
 * that is right on screen and different in the database is the kind of error
 * that is only discovered in a payment dispute.
 */
model PricingLineItem {
  id                String @id @default(uuid()) @db.Uuid
  potentialChangeId String @map("potential_change_id") @db.Uuid
  projectId         String @map("project_id") @db.Uuid

  sequence     Int
  description  String
  quantity     Decimal      @db.Decimal(14, 3)
  unit         String       @default("no")
  rate         Decimal      @db.Decimal(14, 2)
  amount       Decimal      @db.Decimal(14, 2)
  rateSource   RateSource   @default(star_rate) @map("rate_source")
  category     CostCategory @default(other)
  /// The BOQ item this rate came from, where it came from one.
  boqReference String?      @map("boq_reference")
  notes        String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  potentialChange PotentialChange @relation(fields: [potentialChangeId], references: [id], onDelete: Cascade)
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([potentialChangeId, sequence])
  @@map("pricing_line_items")
}

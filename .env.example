# =============================================================================
#  VO Capture & Control — environment template
#
#  Copy to .env and fill in. NEVER commit .env.
#  One filled .env per client deployment. Values are NEVER shared between
#  client deployments — that is the core rule of the deployment model.
# =============================================================================

# --- Deployment identity ------------------------------------------------------
# Which client company this installation belongs to. Used for logging, the
# n8n naming convention, and as a guard against cross-deployment mistakes.
CLIENT_SLUG=MASTER
CLIENT_NAME="Master Template"
APP_URL=http://localhost:3000
NODE_ENV=development

# --- Database (PostgreSQL) ----------------------------------------------------
# Dedicated database per client. Never shared.
DATABASE_URL=postgresql://user:password@localhost:5432/vo_capture
DIRECT_URL=postgresql://user:password@localhost:5432/vo_capture

# --- Supabase -----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=vo-documents

# --- AI (Claude) --------------------------------------------------------------
# Used through the AI-provider abstraction in /src/integrations/claude/.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Background jobs ----------------------------------------------------------
# Engine choice is OPEN — see docs/decisions/0001-background-job-engine.md.
# These are the BullMQ + Redis variables; swap if another engine is chosen.
REDIS_URL=redis://localhost:6379
JOB_QUEUE_PREFIX=vo

# --- n8n integration ----------------------------------------------------------
# The base URL of THIS deployment's n8n workspace.
N8N_BASE_URL=https://n8n.osmanflow.com

# Shared secret n8n presents when calling the app's integration endpoints.
# The app rejects any inbound n8n request without it.
N8N_WEBHOOK_SECRET=

# Shared secret the app presents when triggering an n8n webhook.
N8N_OUTBOUND_SECRET=

# n8n webhook URLs the app calls to request an external action.
N8N_NOTIFY_EMAIL_URL=
N8N_NOTIFY_WHATSAPP_URL=
N8N_DOCUMENT_MOVE_URL=
N8N_REPORT_DELIVERY_URL=

# --- Channel credentials ------------------------------------------------------
# NOTE: these belong in n8n's credential store, NOT here, wherever n8n owns the
# integration. They appear here only for channels the app calls directly.
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_VERIFY_TOKEN=

# --- Audit / retention --------------------------------------------------------
AUDIT_LOG_RETENTION_DAYS=2555

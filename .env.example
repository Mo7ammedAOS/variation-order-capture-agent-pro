# =============================================================================
#  VO Capture & Control — environment template
#
#  Copy to .env and fill in. NEVER commit .env.
#  One filled .env per client deployment. Values are NEVER shared between
#  client deployments — that is the core rule of the deployment model.
# =============================================================================

# --- Deployment identity ------------------------------------------------------
# Which client company this installation belongs to. Used for logging, the
# n8n naming convention, and as a guard against cross-deployment mistakes.
CLIENT_SLUG=MASTER
CLIENT_NAME="Master Template"
# Production is https://vo.osmanflow.com (settled 2026-08-30). It is used to
# build invite links, so a wrong value sends new staff to a dead address.
APP_URL=http://localhost:3000

# Traefik routing on the VPS. APP_HOST is the hostname it serves;
# TRAEFIK_ROUTER names the router, middleware and service, and must be unique
# per deployment on the same box or one stack silently overwrites another's
# route. Unused locally.
APP_HOST=vo.osmanflow.com
TRAEFIK_ROUTER=vo
NODE_ENV=development

# --- Database (PostgreSQL) ----------------------------------------------------
# Dedicated database per client. Never shared.
# Supabase: use the SESSION pooler (port 5432) for both, not the transaction
# pooler. See DEPLOYMENT_GUIDE.md — the transaction pooler needs pgbouncer=true,
# which measured 5x slower per query, and is unsafe without it.
# Session mode caps TOTAL clients (15 on this project, idle ones included), so
# keep connection_limit low and leave headroom for the worker and migrations.
DATABASE_URL=postgresql://user:password@localhost:5432/vo_capture?connection_limit=6&pool_timeout=20
DIRECT_URL=postgresql://user:password@localhost:5432/vo_capture

# --- Supabase -----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=vo-documents

# --- File storage -------------------------------------------------------------
# google_drive — THE PRODUCTION CHOICE (decided 2026-08-30). Supabase Storage
#                caps uploads at 50 MB on the free plan and a drawing set
#                exceeds that on one file. This exact string; the schema
#                rejects "drive" and the app refuses to start.
# supabase     — Supabase Storage, private bucket. Simpler (one vendor, one
#                backup) and the better answer on a paid plan where the cap
#                rises to 50 GB.
# local        — a disk volume. Right for tests and local dev. In production it
#                is the one store nothing backs up.
STORAGE_PROVIDER=local

# In Docker this MUST be /data/uploads, the named volume mounted in
# docker-compose.yml. A relative path writes into the container's own
# filesystem, and every rebuild destroys the evidence — silently, because the
# database rows survive and only the files vanish.
LOCAL_STORAGE_ROOT=./.uploads

# Drive auth. osmanflow.com is a personal Gmail, so oauth is the only option:
# Shared Drives need Workspace, and a service account has no storage quota of
# its own, so uploads into a merely-shared My Drive folder fail with
# storageQuotaExceeded.
#
# Mint the refresh token once, on your own machine:   npm run drive:token
# It never belongs in this file or the repo — only in .env.production, 0600.
GOOGLE_DRIVE_AUTH_MODE=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# --- AI (Claude) --------------------------------------------------------------
# Used through the AI-provider abstraction in /src/integrations/claude/.
#
# AI_PROVIDER defaults to `mock` — a keyword extractor that costs nothing and
# needs no key. Switching it to `claude` is the ONLY thing that makes this
# system spend money, and it is deliberately a separate decision from deploying:
# the app boots, captures, notices, prices and invoices with it left alone.
#
# With `claude`, one short call is made per captured message. The instructions
# are a cached prefix, so every message after the first is billed at about a
# tenth on that part. If the key is wrong or Anthropic is unreachable, capture
# falls back to the keyword extractor and says so in the log — a report is
# never lost because a third party is down.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Background jobs ----------------------------------------------------------
# Engine choice is OPEN — see docs/decisions/0001-background-job-engine.md.
# These are the BullMQ + Redis variables; swap if another engine is chosen.
REDIS_URL=redis://localhost:6379
JOB_QUEUE_PREFIX=vo

# --- n8n integration ----------------------------------------------------------
# The base URL of THIS deployment's n8n workspace.
N8N_BASE_URL=https://n8n.osmanflow.com

# Shared secret n8n presents when calling the app's integration endpoints.
# The app rejects any inbound n8n request without it.
N8N_WEBHOOK_SECRET=

# Shared secret the app presents when triggering an n8n webhook.
N8N_OUTBOUND_SECRET=

# n8n webhook URLs the app calls to request an external action.
#
# Take these from the PRODUCTION URL of lanes D and E after importing
# n8n-workflows/master.json — the test URL only listens while the editor is
# open, which is exactly the kind of thing that works all afternoon and stops
# the moment you close the tab.
#
# While these are blank, notifications are still recorded and still owed: the
# rows sit `pending` with the reason "Channel not configured" and go out the
# moment a URL appears. Nothing is lost by wiring them late.
N8N_NOTIFY_EMAIL_URL=
N8N_NOTIFY_WHATSAPP_URL=
N8N_DOCUMENT_MOVE_URL=
N8N_REPORT_DELIVERY_URL=

# --- Who holds the clock ------------------------------------------------------
# `true` runs the reminder sweep on a timer inside this container. Set it to
# FALSE once lane S of master.json is active, so there is one schedule and it is
# the one you can see. Both running is harmless — the notification dedupe key
# absorbs the second run — but two clocks with one owner is a thing nobody
# remembers a year later.
ENABLE_SCHEDULER=true

# --- Channel credentials ------------------------------------------------------
# NOTE: these belong in n8n's credential store, NOT here, wherever n8n owns the
# integration. They appear here only for channels the app calls directly.
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_VERIFY_TOKEN=

# --- Audit / retention --------------------------------------------------------
AUDIT_LOG_RETENTION_DAYS=2555

{
  "name": "vo-capture-control",
  "version": "0.1.0",
  "private": true,
  "description": "Variation Notice, Capture, Approval & Bottleneck-Control System for UAE fit-out contractors",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"tests/integration/**\"",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx --conditions=react-server prisma/seed.ts",
    "worker": "tsx --conditions=react-server src/workers/index.ts",
    "test:db": "vitest run tests/integration",
    "test:all": "vitest run",
    "drive:token": "node scripts/google-oauth-token.mjs",

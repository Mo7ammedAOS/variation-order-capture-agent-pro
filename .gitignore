# ============================================================================
#  SECRETS — never commit.
#  .env.example (placeholders only) IS committed and is negated below.
# ============================================================================
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
credentials.json
service-account*.json

# ============================================================================
#  CLIENT COMMERCIAL DATA — never commit.
#  Contracts, BOQs, pricing, drawings and correspondence belong to the client
#  and live in that client's own document storage, never in source control.
# ============================================================================
/client-data/
*.boq.*
contracts/
tender/
**/drawings/
*.dwg
*.rvt

# --- n8n workflow exports: committed, but only AFTER scrubbing ---
#     See n8n-workflows/README.md. Raw unscrubbed dumps are ignored.
n8n-workflows/*.raw.json
wf.json

# --- node / next / build ---
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# --- test / coverage ---
coverage/
.nyc_output/
playwright-report/
test-results/

# --- runtime data / docker volumes ---
postgres_data/
redis_data/
n8n_data/
caddy_data/
*_storage/

# --- backups / dumps ---
*.tar.gz
*.sql
# ...but migrations and the hand-written SQL ARE the deployment. Without these
# committed, `prisma migrate deploy` on the VPS has nothing to apply.
!prisma/migrations/**/*.sql
!prisma/sql/*.sql
*.sql.gz
*.dump

# --- logs ---
*.log
npm-debug.log*
yarn-error.log*

# --- python artefacts ---
__pycache__/
*.pyc

# --- OS cruft ---
.DS_Store
Thumbs.db
desktop.ini

# --- editor ---
.vscode/*
!.vscode/extensions.json
.idea/

# --- claude local overrides (settings.local.json is per-machine) ---
.claude/settings.local.json
.claude/settings.local.json.bak

# Every printable document, and the HTML each one is rendered from.
#
# The repo is PUBLIC. The markdown in docs/ is the source and IS tracked; the
# PDFs are rendered from it and are not. Two of them must never be pushed at
# all: the ROI sheet carries the setup price, and the meeting guide is the
# script for selling it. Neither belongs anywhere a client can read it.
#
# Rebuild the test plan with: python3 scripts/build-test-plan-pdf.py
docs/pdf/

# Standalone design mock-ups, opened straight in a browser. They are working
# sketches, not app code — nothing imports them and nothing builds them.
.design-preview/

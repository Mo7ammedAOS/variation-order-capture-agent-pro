# ============================================================================
#  SECRETS — never commit.
#  .env.example (placeholders only) IS committed and is negated below.
# ============================================================================
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
credentials.json
service-account*.json

# ============================================================================
#  CLIENT COMMERCIAL DATA — never commit.
#  Contracts, BOQs, pricing, drawings and correspondence belong to the client
#  and live in that client's own document storage, never in source control.
# ============================================================================
/client-data/
*.boq.*
contracts/
tender/
**/drawings/
*.dwg
*.rvt

# --- n8n workflow exports: committed, but only AFTER scrubbing ---
#     See n8n-workflows/README.md. Raw unscrubbed dumps are ignored.
n8n-workflows/*.raw.json
wf.json

# --- node / next / build ---
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# --- test / coverage ---
coverage/
.nyc_output/
playwright-report/
test-results/

# --- runtime data / docker volumes ---
postgres_data/
redis_data/
n8n_data/
caddy_data/
*_storage/

# --- backups / dumps ---
*.tar.gz
*.sql
*.sql.gz
*.dump

# --- logs ---
*.log
npm-debug.log*
yarn-error.log*

# --- python artefacts ---
__pycache__/
*.pyc

# --- OS cruft ---
.DS_Store
Thumbs.db
desktop.ini

# --- editor ---
.vscode/*
!.vscode/extensions.json
.idea/

# --- claude local overrides (settings.local.json is per-machine) ---
.claude/settings.local.json
.claude/settings.local.json.bak

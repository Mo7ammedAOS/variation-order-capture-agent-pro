          "rawBody": true
        }
      },
      "id": "n018-d1",
      "name": "D1 · Webhook: Notify Email",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -300,
        620
      ],
      "webhookId": "vo-notify-email"
    },
    {
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.headers['x-vo-timestamp'] + '.' + $json.rawBody.toString() }}",
        "dataPropertyName": "expected",
        "secret": "={{ $env.VO_OUTBOUND_SECRET }}",
        "encoding": "hex"
      },

    {
      "parameters": {
        "jsCode": "const node = $json.execution?.lastNodeExecuted ?? '';\nconst lane = (node.match(/^([A-Z])\\d/) ?? [])[1] ?? '?';\n\nconst LANES = {\n  A: 'WhatsApp capture', B: 'Email capture', C: 'Document watch',\n  D: 'Email out', E: 'WhatsApp out', S: 'Scheduled jobs',\n  F: 'Client follow-up', G: 'Weekly report',\n};\n\nreturn [{ json: {\n  lane,\n  lane_name: LANES[lane] ?? 'Unknown lane',\n  node,\n  message: $json.execution?.error?.message ?? 'No message',\n  workflow: $json.workflow?.name ?? '',\n  execution_url: $json.execution?.url ?? '',\n  at: new Date().toISOString(),\n} }];"
      },

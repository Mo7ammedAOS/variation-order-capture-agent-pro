    {
      "parameters": {
        "jsCode": "// The project code comes from the folder name, which is where the app puts it\n// (`DXB-001 — Dubai Office Fit-Out`). If it cannot be read, send it anyway and\n// let the app reject it: a 4xx that names the file beats a document filed\n// against a project somebody guessed at.\nconst name = $json.name ?? '';\nconst parentName = $json.parentFolderName ?? $json.parents?.[0]?.name ?? '';\nconst code = (parentName.match(/^[A-Z]{2,4}-\\d{3}/) ?? name.match(/^[A-Z]{2,4}-\\d{3}/) ?? [''])[0];\n\nconst payload = {\n  idempotency_key: 'drive:' + ($json.id ?? ''),\n  project_code: code,\n  document_name: name,\n  document_type: 'other',\n  external_file_id: $json.id,\n  source_url: $json.webViewLink || undefined,\n};\n\nreturn [{ json: { ts: String(Date.now()), payload: JSON.stringify(payload) } }];"
      },

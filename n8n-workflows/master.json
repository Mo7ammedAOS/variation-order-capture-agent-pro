    },
    {
      "parameters": {
        "jsCode": "// A failed send is recorded as failed, with the reason. Silence here would\n// leave a notification pending for ever and nobody would know it never went.\nconst src = $('D3 · Signature Valid?').item.json.body;\nconst payload = {\n  idempotency_key: 'delivery:' + src.notification_id,\n  notification_id: src.notification_id,\n  status: 'failed',\n  failure_reason: String($json.error?.message ?? 'Gmail send failed').slice(0, 400),\n};\nreturn [{ json: { ts: String(Date.now()), payload: JSON.stringify(payload) } }];"
      },
      "id": "n026-d6",
      "name": "D6 · Email Failed",

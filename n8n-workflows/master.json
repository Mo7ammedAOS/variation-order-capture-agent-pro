    {
      "parameters": {
        "jsCode": "const h = ($json.payload?.headers ?? []).reduce((acc, x) => {\n  acc[String(x.name).toLowerCase()] = x.value; return acc;\n}, {});\n\nconst from = String(h.from ?? '');\nconst match = from.match(/^\\s*(?:\\\"?([^\\\"<]*?)\\\"?\\s*)?<?([^\\s<>]+@[^\\s<>]+)>?\\s*$/);\n\nconst payload = {\n  idempotency_key: 'gmail:' + ($json.id ?? ''),\n  received_at: new Date(Number($json.internalDate) || Date.now()).toISOString(),\n  from: { address: (match?.[2] ?? from).toLowerCase(), name: match?.[1] || undefined },\n  to: String(h.to ?? '').split(',').map((s) => s.trim()).filter(Boolean),\n  cc: String(h.cc ?? '').split(',').map((s) => s.trim()).filter(Boolean),\n  subject: h.subject ?? '',\n  body_text: $json.snippet ?? '',\n  attachments: [],\n};\n\nreturn [{ json: { ts: String(Date.now()), payload: JSON.stringify(payload) } }];"
      },

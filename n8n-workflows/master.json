            "caseSensitive": true,
            "version": 2,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "D-sig",
              "leftValue": "={{ $json.expected }}",
              "rightValue": "={{ $json.headers['x-vo-signature'] }}",
              "operator": {

    {
      "parameters": {
        "jsCode": "// The app treats its own outbound request as 'queued', never 'sent'. This\n// call is the only thing that can move a notification to delivered, and the\n// only evidence that a message actually left the building.\nconst src = $('D3 · Signature Valid?').item.json.body;\nconst payload = {\n  idempotency_key: 'delivery:' + src.notification_id,\n  notification_id: src.notification_id,\n  status: 'sent',\n  external_message_id: $json.id ?? undefined,\n};\nreturn [{ json: { ts: String(Date.now()), payload: JSON.stringify(payload) } }];"
      },
      "id": "n023-d7",
      "name": "D7 · Build Delivery Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        580,
        620
      ]
    },
    {
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.ts + '.' + $json.payload }}",
        "dataPropertyName": "signature",
        "secret": "={{ $env.VO_WEBHOOK_SECRET }}",
        "encoding": "hex"
      },
      "id": "n024-d8",

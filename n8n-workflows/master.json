      "id": "n013-c1",
      "name": "C1 · Drive Trigger",
      "type": "n8n-nodes-base.googleDriveTrigger",
      "typeVersion": 1,
      "position": [
        -300,
        340
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "H3pANIGlx4tZ8vU4",
